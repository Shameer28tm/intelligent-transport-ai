# ==========================================
# Intelligent Transport AI - Environment Template
# ==========================================

# Database Configuration
# Local development default:
DATABASE_URL=sqlite:///./transport.db
# Neon PostgreSQL production (obtain from `neon connection-string` or console):
# DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-sample-instance.us-east-2.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_BYTES=20971520
VISION_ADAPTER=real
VISION_MODEL_PATH=backend/weights/yolov8n.onnx
UPLOAD_DIR=./uploads

# TomTom Traffic API Integration (Server-Side Only)
# Obtain key at https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# Mappls (MapmyIndia) Integration (Legacy)
# Request credentials at https://about.mappls.com/api/
MAPPLS_CLIENT_ID=your_mappls_client_id_here
MAPPLS_CLIENT_SECRET=your_mappls_client_secret_here
MAPPLS_REST_KEY=your_mappls_rest_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_MAP_DEFAULT_LAT=37.7749
VITE_MAP_DEFAULT_LNG=-122.4194
VITE_MAP_DEFAULT_ZOOM=12
VITE_ENVIRONMENT=development
VITE_DATA_PROVENANCE="SIMULATED DEMO DATA"

# Optional: CARTO Basemaps API Key (request free at https://carto.com/basemaps/apikey)
# Default is 100% keyless public Dark Gray Canvas (no key required)
VITE_CARTO_API_KEY=